# SafeWatch configuration. Copy to .env — never commit real values.
# The server reads these from the process environment; with `npm run dev:server`
# export them or use: node --env-file=.env (Node 20+).

# ───── Frontend (public: everything prefixed VITE_ ships to the browser — NO secrets) ─────
VITE_APP_NAME=SafeWatch
# Client-side upload limit in MB (validated at startup; 1–4096). Keep ≤ the server limit.
VITE_MAX_UPLOAD_MB=2048
# API origin. Leave empty in development: the Vite dev server proxies /api to the local API (no CORS needed).
# In production either serve the SPA and API from one origin, or set this and add the SPA origin to SAFEWATCH_ALLOWED_ORIGINS.
VITE_API_URL=
# "server" uploads to the SafeWatch API (default). "browser" only validates and reads metadata locally, no server needed.
VITE_MEDIA_BACKEND=server

# ───── Server (private) ─────
NODE_ENV=development
SAFEWATCH_HOST=127.0.0.1
SAFEWATCH_PORT=8787
# Dedicated directory for temporary media. Created with mode 0700. Must be empty or previously created by SafeWatch.
# Default: <os tmpdir>/safewatch-media
# SAFEWATCH_STORAGE_DIR=
SAFEWATCH_MAX_UPLOAD_MB=2048
# Exact origins allowed to call the API cross-origin (comma-separated). "*" is rejected.
SAFEWATCH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAFEWATCH_UPLOAD_TIMEOUT_MS=1800000
SAFEWATCH_PROCESSING_TIMEOUT_MS=60000
SAFEWATCH_MAX_CONCURRENT_UPLOADS=4
SAFEWATCH_MAX_CONCURRENT_PROCESSING=2
SAFEWATCH_MAX_QUEUED_PROCESSING=20
# How long stored media (and its record) lives before automatic deletion.
SAFEWATCH_RETENTION_MINUTES=60
SAFEWATCH_SWEEP_INTERVAL_SECONDS=60

# ───── Extraction (audio, subtitles, frames). All limits are hard caps: exceeding one fails the extraction safely and deletes partial output. ─────
SAFEWATCH_EXTRACTION_TIMEOUT_MS=600000
SAFEWATCH_MAX_CONCURRENT_EXTRACTION=1
SAFEWATCH_MAX_QUEUED_EXTRACTION=20
# One frame per this many seconds (the interval grows automatically so the count never exceeds the maximum).
SAFEWATCH_FRAME_INTERVAL_SECONDS=10
SAFEWATCH_FRAME_MAX_COUNT=300
# Frames are scaled to fit inside this box (aspect ratio preserved, never upscaled).
SAFEWATCH_FRAME_MAX_WIDTH=768
SAFEWATCH_FRAME_MAX_HEIGHT=768
# Total size of all frames of one media item.
SAFEWATCH_FRAME_MAX_TOTAL_MB=64
# Total size of all extracted audio of one media item (16 kHz mono WAV is about 115 MB per hour per track).
SAFEWATCH_AUDIO_MAX_MB=512
SAFEWATCH_AUDIO_MAX_TRACKS=8
SAFEWATCH_SUBTITLE_MAX_CUES=50000
SAFEWATCH_SUBTITLE_MAX_MB=8


# ───── Speech-to-text (local, optional). Audio is processed on THIS machine by whisper.cpp; nothing is sent to a third party. ─────
# Setup: brew install whisper-cpp && scripts/download-speech-model.sh   (then set the two lines below)
# "none" (default) disables speech-to-text; subtitle text is still collected.
SAFEWATCH_SPEECH_PROVIDER=none
# SAFEWATCH_SPEECH_PROVIDER=whispercpp
# SAFEWATCH_SPEECH_MODEL_PATH=models/ggml-base.bin
# SAFEWATCH_SPEECH_BINARY=whisper-cli
# "auto" detects the spoken language. A code such as "en" or "hi" forces it (and prefers the matching audio track). Speech is never translated.
SAFEWATCH_SPEECH_LANGUAGE=auto
SAFEWATCH_SPEECH_TIMEOUT_MS=600000
SAFEWATCH_SPEECH_MAX_AUDIO_MB=256
SAFEWATCH_SPEECH_MAX_DURATION_SECONDS=3600
SAFEWATCH_MAX_CONCURRENT_SPEECH=1
SAFEWATCH_MAX_QUEUED_SPEECH=20
# How many audio tracks to transcribe per video (the best one by language/default/ordinal; others are listed as "not selected").
SAFEWATCH_SPEECH_MAX_TRACKS=1
SAFEWATCH_SPEECH_THREADS=4

# Defaults resolve ffmpeg/ffprobe from PATH.
# SAFEWATCH_FFMPEG_PATH=
# SAFEWATCH_FFPROBE_PATH=
# debug | info | warn | error | silent
SAFEWATCH_LOG_LEVEL=info


# ───── Visual analysis (local, optional, macOS only). Frames are processed on THIS machine by Apple Vision; nothing is sent to a third party. ─────
# Setup: scripts/build-vision-helper.sh   (needs the Xcode Command Line Tools; builds bin/safewatch-vision, git-ignored)
# "none" (default) disables visual analysis; everything else still works.
SAFEWATCH_VISION_PROVIDER=none
# SAFEWATCH_VISION_PROVIDER=apple-vision
# SAFEWATCH_VISION_BINARY=bin/safewatch-vision
# Per batch of frames. The very first run after a reboot compiles Apple's models and can take ~30 s.
SAFEWATCH_VISION_TIMEOUT_MS=120000
SAFEWATCH_VISION_MAX_FRAMES=300
SAFEWATCH_VISION_BATCH_SIZE=8
SAFEWATCH_VISION_MAX_FRAME_MB=8
SAFEWATCH_VISION_MIN_CONFIDENCE=0.1
SAFEWATCH_VISION_MAX_LABELS=8
SAFEWATCH_VISION_MAX_OBSERVATIONS_PER_FRAME=64
SAFEWATCH_MAX_CONCURRENT_VISION=1
SAFEWATCH_MAX_QUEUED_VISION=20
