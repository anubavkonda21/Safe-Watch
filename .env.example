# SafeWatch configuration. Copy to .env — never commit real values.
# The server reads these from the process environment; with `npm run dev:server`
# export them or use: node --env-file=.env (Node 20+).

# ───── Frontend (public: everything prefixed VITE_ ships to the browser — NO secrets) ─────
VITE_APP_NAME=SafeWatch
# Client-side upload limit in MB (validated at startup; 1–4096). Keep ≤ the server limit.
VITE_MAX_UPLOAD_MB=2048
# API origin. Leave empty in development: the Vite dev server proxies /api to the local API (no CORS needed).
# In production either serve the SPA and API from one origin, or set this and add the SPA origin to SAFEWATCH_ALLOWED_ORIGINS.
VITE_API_URL=
# "server" uploads to the SafeWatch API (default). "browser" only validates and reads metadata locally, no server needed.
VITE_MEDIA_BACKEND=server

# ───── Server (private) ─────
NODE_ENV=development
SAFEWATCH_HOST=127.0.0.1
SAFEWATCH_PORT=8787
# Dedicated directory for temporary media. Created with mode 0700. Must be empty or previously created by SafeWatch.
# Default: <os tmpdir>/safewatch-media
# SAFEWATCH_STORAGE_DIR=
SAFEWATCH_MAX_UPLOAD_MB=2048
# Exact origins allowed to call the API cross-origin (comma-separated). "*" is rejected.
SAFEWATCH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAFEWATCH_UPLOAD_TIMEOUT_MS=1800000
SAFEWATCH_PROCESSING_TIMEOUT_MS=60000
SAFEWATCH_MAX_CONCURRENT_UPLOADS=4
SAFEWATCH_MAX_CONCURRENT_PROCESSING=2
SAFEWATCH_MAX_QUEUED_PROCESSING=20
# How long stored media (and its record) lives before automatic deletion.
SAFEWATCH_RETENTION_MINUTES=60
SAFEWATCH_SWEEP_INTERVAL_SECONDS=60
# Defaults resolve ffmpeg/ffprobe from PATH.
# SAFEWATCH_FFMPEG_PATH=
# SAFEWATCH_FFPROBE_PATH=
# debug | info | warn | error | silent
SAFEWATCH_LOG_LEVEL=info
